{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/ai.ts": {
      "maxDuration": 300
    },
    "api/prepare.ts": {
      "maxDuration": 300
    },
    "api/cron.ts": {
      "maxDuration": 60
    },
    "api/inbound.ts": {
      "maxDuration": 90
    }
  },
  "redirects": [
    {
      "source": "/p/:slug([a-z0-9]{10,24})",
      "missing": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|SkypeUriPreview|Applebot|Pinterestbot|redditbot|Embedly|vkShare|Iframely|Googlebot|bingbot).*"
        }
      ],
      "destination": "/?t=:slug",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug([a-z0-9]{10,24})",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|SkypeUriPreview|Applebot|Pinterestbot|redditbot|Embedly|vkShare|Iframely|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/preview?t=:slug"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "query",
          "key": "t",
          "value": "(?<t>[a-z0-9]{10,24})"
        },
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(?:WhatsApp|facebookexternalhit|Facebot|Twitterbot|TelegramBot|Slackbot|Discordbot|LinkedInBot|SkypeUriPreview|Applebot|Pinterestbot|redditbot|Embedly|vkShare|Iframely|Googlebot|bingbot).*"
        }
      ],
      "destination": "/api/preview?t=:t"
    }
  ]
}
